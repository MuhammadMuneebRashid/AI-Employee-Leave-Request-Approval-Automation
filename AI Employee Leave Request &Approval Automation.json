    {
      "parameters": {
        "jsCode": "const fields=$input.first().json.body.data.fields;\nconst field_1=fields.find(f=>f.label===\"Full Name:\");\nconst name=field_1.value;\nconst field_2=fields.find(f=>f.label===\"Email:\");\nconst email=field_2.value;\nconst field_3=fields.find(f=>f.label===\"Leave Type:\");\nconst value=field_3.value[0];\nconst options=field_3.options.find(o=>o.id===value);\nconst leave_type=options.text;\nconst field_4=fields.find(f=>f.label===\"Start Date:\");\nconst start_date=field_4.value;\nconst field_5=fields.find(f=>f.label===\"End Date:\");\nconst end_date=field_5.value;\nconst field_6=fields.find(f=>f.label===\"Reason for leave:\");\nconst reason_for_leave=field_6.value;\n\nreturn[{\n   name,\n  email,\n  leave_type,\n  start_date,\n  end_date,\n  reason_for_leave\n}] "
      },
