    {
      "parameters": {
        "jsCode": "const leaves = $input.all();\n\nconst request = $('Edit Fields').first().json;\n\n\n// Convert DD-M-YYYY / DD-MM-YYYY into YYYY-MM-DD timestamp\nfunction parseDate(value) {\n  if (!value) {\n    return null;\n  }\n\n  const parts = String(value).trim().split(\"-\");\n\n  if (parts.length !== 3) {\n    return null;\n  }\n\n  const day = Number(parts[0]);\n  const month = Number(parts[1]);\n  const year = Number(parts[2]);\n\n  if (\n    !Number.isInteger(day) ||\n    !Number.isInteger(month) ||\n    !Number.isInteger(year)\n  ) {\n    return null;\n  }\n\n  // Create UTC date to avoid timezone problems\n  const date = new Date(Date.UTC(year, month - 1, day));\n\n  // Validate date\n  if (\n    isNaN(date.getTime()) ||\n    date.getUTCFullYear() !== year ||\n    date.getUTCMonth() !== month - 1 ||\n    date.getUTCDate() !== day\n  ) {\n    return null;\n  }\n\n  return date.getTime();\n}\n\n\n// Normalize email\nfunction normalizeEmail(email) {\n  return String(email || \"\")\n    .trim()\n    .toLowerCase();\n}\n\n\n// Requested leave dates\nconst requestedStart = parseDate(request.start_date);\nconst requestedEnd = parseDate(request.end_date);\n\n\n// Check invalid dates\nif (requestedStart === null || requestedEnd === null) {\n  return [\n    {\n      json: {\n        ...request,\n        isValid: false,\n        leave_days: 0,\n        conflict: false,\n        message: \"Invalid leave dates\"\n      }\n    }\n  ];\n}\n\n\n// Check end date before start date\nif (requestedEnd < requestedStart) {\n  return [\n    {\n      json: {\n        ...request,\n        isValid: false,\n        leave_days: 0,\n        conflict: false,\n        message: \"End date cannot be before start date\"\n      }\n    }\n  ];\n}\n\n\n// Calculate leave days\nconst millisecondsPerDay = 24 * 60 * 60 * 1000;\n\nconst leaveDays =\n  Math.floor(\n    (requestedEnd - requestedStart) / millisecondsPerDay\n  ) + 1;\n\n\n// Request employee email\nconst requestEmail = normalizeEmail(request.email);\n\n\n// Check conflict\nconst conflict = leaves.some(item => {\n\n  const existing = item.json;\n\n  // Ignore empty rows\n  if (!existing.start_date || !existing.end_date) {\n    return false;\n  }\n\n\n  // Check employee email\n  const existingEmail = normalizeEmail(existing.email);\n\n  if (!requestEmail || !existingEmail) {\n    return false;\n  }\n\n  if (requestEmail !== existingEmail) {\n    return false;\n  }\n\n\n  // Parse existing leave dates\n  const existingStart = parseDate(existing.start_date);\n  const existingEnd = parseDate(existing.end_date);\n\n  if (existingStart === null || existingEnd === null) {\n    return false;\n  }\n\n\n  // Check date overlap\n  // Same date = CONFLICT\n  // Partial overlap = CONFLICT\n  // Full overlap = CONFLICT\n  return (\n    requestedStart <= existingEnd &&\n    requestedEnd >= existingStart\n  );\n});\n\n\n// Final result\nreturn [\n  {\n    json: {\n      ...request,\n      leave_days: leaveDays,\n      conflict: conflict,\n      isValid: !conflict,\n      message: conflict\n        ? \"Leave dates conflict with an existing leave request\"\n        : \"Leave request is valid\"\n    }\n  }\n];"
      },
